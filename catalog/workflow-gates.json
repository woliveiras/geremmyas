    {
      "id": "feature-material-authority",
      "classification": "retained-authority-boundary",
      "path": "content/skills/refine/references/readiness-and-authority.md",
      "pattern": "(?i)ask the user only at a",
      "note": "One focused question remains for a real authority boundary or material objective ambiguity."
